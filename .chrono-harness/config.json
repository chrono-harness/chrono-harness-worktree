    "filemap": ".chrono-harness/FILEMAP.json",
    "workflow": ".chrono-harness/workflow.json"
  },
  "canonical_check": {
    "operation": "validate.delta",
    "argv": [
      ".chrono-harness/bin/chrono-harness",
      "check"
    ],
    "profile": ".chrono-harness/ci/check.json",
    "inputs": {
      "local": {
        "operation": "prepare.check.local",
        "tool": "chrono-worktree",
        "argv": [
          "check-inputs",
          "--config",
          ".chrono-harness/worktree.json"
        ]
      },
      "ci": {
        "operation": "prepare.check.ci",
        "tool": "chrono-ci",
        "argv": [
          "check-inputs",
          "--config",
          ".chrono-harness/ci/units.json",
          "--event-env",
          "GITHUB_EVENT_NAME",
          "--payload-env",
          "GITHUB_EVENT_PATH",
          "--revision-env",
          "CHRONO_WORKFLOW_REVISION",
          "--repository-env",
          "GITHUB_REPOSITORY"
        ]
      }
    },
    "participation": {
      "operation": "worktree.check",
      "tool": "chrono-worktree",
      "argv": [
        "check"
      ]
    }
  },
  "protocol": {
    "id": "chrono-judge/v1",
    "timeout_seconds": 2400,
    "stdout_limit_bytes": 67108864,
    "encoding": "UTF-8"
  },
  "environment": {
    "credential_environment": [
      "GH_TOKEN"
    ],
    "inherit": [
      "PATH",
      "HOME",
      "TMPDIR",
      "CHRONO_CHECK_SOURCE",
      "GITHUB_EVENT_NAME",
      "GITHUB_EVENT_PATH",
      "CHRONO_WORKFLOW_REVISION",
      "GITHUB_REPOSITORY",
      "GH_TOKEN",
      "SSH_AUTH_SOCK",
      "CHRONO_CI_DETECTION",
      "CHRONO_CI_NEEDS",
      "GITHUB_RUN_ID",
      "GITHUB_RUN_ATTEMPT",
      "GITHUB_JOB",
      "MISE_DATA_DIR",
      "MISE_CACHE_DIR",
      "MISE_STATE_DIR",
      "CARGO_HOME",
      "RUSTUP_HOME",
      "VERUS",
      "MISE_TRUSTED_CONFIG_PATHS"
    ],
    "values": {},
    "inputs": []
  },
  "facts_git": {
    "tool": "git"
  },
