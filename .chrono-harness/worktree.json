{
  "schema": "chrono-worktree-config/v3",
  "host_config": ".chrono-harness/config.json",
  "diagnostics_program": "chrono-diagnostics",
  "registration_program": "chrono-judge-registration",
  "remote": "origin",
  "git": {
    "program": "git",
    "expected_version": null,
    "sha256": null
  },
  "environment": {
    "inherit": [
      "PATH",
      "HOME",
      "SSH_AUTH_SOCK"
    ],
    "values": {
      "GIT_TERMINAL_PROMPT": "0"
    }
  },
  "timeout_seconds": 120,
  "output_limit_bytes": 1048576,
  "report_directory": ".chrono-harness/state/worktrees/",
  "check_inputs": {
    "origin_path": ".chrono-harness/state/origins/current.json",
    "context_path": ".chrono-harness/state/local/context.json",
    "collection_manifest": ".chrono-harness/state/collection/manifest.json",
    "roles": {
      "feature": "integration",
      "integration": "integration"
    },
    "optional_input_file": ".chrono-harness/state/tool-selection/versions.toml"
  },
  "automatic_cleanup": ".chrono-harness/cleanup.json"
}
