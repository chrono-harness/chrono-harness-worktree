      "root": "crates/worktree",
      "test_project": "worktree-tests",
      "actions": {
        "verify_owner_publication": {
          "operation": "verify.owner-publication",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link={operation_state}/verify.owner-publication.rlib,dep-info={operation_state}/verify.owner-publication.rlib.d",
            "crates/worktree/src/verified_owner_publication.rs",
            "-o",
            "{operation_state}/verify.owner-publication.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
